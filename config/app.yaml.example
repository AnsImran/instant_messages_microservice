# -----------------------------------------------------------------------------
# Instant Messages Microservice — non-secret runtime configuration.
#
# Copy this file to config/app.yaml (or mount as a Docker volume) and edit.
# Changes pick up after a server restart, or via:
#
#   POST /api/v1/admin/reload-config   (with X-Admin-Key header)
# -----------------------------------------------------------------------------

teams:
  # Named webhook registry — clients send webhook_target: "superstat" to route.
  #
  # OUTBOUND MESSAGING IS DELIBERATELY OFF ACROSS THE WHOLE SYSTEM and this map is
  # where the exam-distribution side of it is held off. Every name below is a real
  # target that a running service already asks for by name; each is commented out,
  # so an unknown-target 400 comes back and the caller records the message instead
  # of sending it. That is the intended state, not a gap — the same arrangement as
  # `teams_webhook_url` in the engine's notification_targets.yaml and `send_enforced`
  # further down this file: the code stays, the address is withheld.
  #
  # NOTHING IS LOST WHILE THEY ARE OFF. A held-back alarm is still written to its
  # service's console in full, and anything serious enough to stop the roster being
  # served freezes the engine's cycle, which puts a notice at the top of the report
  # that is emailed every five minutes.
  #
  # TO RELEASE: uncomment the ones you want and paste the Teams webhook URL, in
  # config/app.yaml on the host (this file is the shape only). No code changes, no
  # rebuild, no redeploy — POST /api/v1/admin/reload-config picks it up.
  named_webhooks:
    # superstat: "https://..."
    # marketing: "https://..."
    #
    # --- radiologists_service, the roster feed -------------------------------------
    # Grouped by AUDIENCE rather than by severity: the target answers "whose problem
    # is this?", which is what decides whether anybody acts. Severity is in the text.
    #
    # exam_distribution — the exam-distribution chat. Roles could not be read from
    #   NewVue and a cached copy is in use; or no roles at all; or an account holds
    #   the Radiologist role but is not Active, so it is being given no exams.
    #   Addressed to whoever is RELYING on the roles, not to whoever repairs them.
    # exam_distribution: "https://..."
    #
    # roster_data — Renew support. The data itself is wrong or suspect: a mapping
    #   came back empty, an unseen vocabulary value appeared, the canary failed.
    #   These are edits somebody made in NewVue and can unmake.
    # roster_data: "https://..."
    #
    # roster_feed — engineering. An upstream stopped answering or changed shape.
    # roster_feed: "https://..."
    #
    # roster_config — whoever runs the service. Our own configuration is wrong: an
    #   override row binding to nobody, a cadence file that will not load.
    # roster_config: "https://..."

  # Default styling applied when the caller omits values (currently advisory;
  # reserved for future expansion).
  defaults:
    banner_style: "attention"
    title_weight: "bolder"
    title_size: "medium"

http:
  # Timeout (seconds) applied to every outbound webhook POST.
  timeout_seconds: 15
  # Retries on timeout / network error / 5xx / 429. Other 4xx is never retried.
  max_retries: 2
  # Ceiling (seconds) on how long an upstream 429 "Retry-After" is obeyed before
  # the retry sleep is clamped — stops a hostile/huge value parking the queue.
  max_retry_after_seconds: 10
  # Max recent terminal delivery failures kept for GET /admin/dead-letters.
  dead_letter_capacity: 200

  # Durable outbox: when enabled, the per-webhook queue is mirrored to a SQLite
  # file so items survive a restart/crash (at-least-once delivery). OFF by
  # default. Requires a SINGLE uvicorn worker + a writable data volume (the
  # compose file mounts one). db_path is RESTART-ONLY (not hot-reloadable).
  queue:
    persistence_enabled: false
    db_path: data/outbox.sqlite3
    max_attempts: 10

api:
  cors:
    # Origins allowed to call the API from a browser.
    allow_origins:
      - "*"

  # Inbound auth for the /teams send endpoints. The secret key itself lives in
  # .env (SEND_API_KEY) — NEVER here. Leave send_enforced false during rollout
  # (grace mode: accept with/without the key, log adoption), flip to true only
  # after every caller sends a valid X-Api-Key.
  auth:
    send_enforced: false

  # Per-caller token-bucket rate limit for the send endpoints. Off by default so
  # legitimate traffic is never 429'd until the limits are sized for real peak.
  rate_limit:
    enabled: false
    capacity: 120
    refill_per_sec: 20
